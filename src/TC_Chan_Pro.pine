//@version=6
indicator(
     "TC Chan Pro M2 - Normalized Bar + Fractal",
     shorttitle = "TC Chan M2",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 100)

//=============================================================================
// TC CHAN PRO
// M2 - NORMALIZED BAR + CONTAINMENT + FRACTAL
//
// Version : 0.2.1
//
// Architecture:
//
//     Raw K
//       |
//       v
//     Containment
//       |
//       v
//     Normalized Bar
//       |
//       v
//     Fractal
//
// M2 does NOT create strokes yet.
// Stroke Engine starts in M3.
//=============================================================================


//=============================================================================
// 01. INPUTS
//=============================================================================

groupGeneral = "01 - General"

showFractals = input.bool(
     true,
     "Show Fractals",
     group = groupGeneral)

showContainment = input.bool(
     true,
     "Show Containment",
     group = groupGeneral)

showNormalized = input.bool(
     false,
     "Show Normalized Bars",
     group = groupGeneral)

showDebug = input.bool(
     false,
     "Debug Mode",
     group = groupGeneral)


groupFractal = "02 - Fractal"

fractalMode = input.string(
     "Practical",
     "Fractal Mode",
     options = ["Strict", "Practical"],
     group = groupFractal)

requireAlternation = input.bool(
     true,
     "Require Fractal Alternation",
     group = groupFractal)

minFractalDistance = input.int(
     1,
     "Minimum Source Bars Between Fractals",
     minval = 0,
     maxval = 100,
     group = groupFractal)


groupContainment = "03 - Containment"

directionMode = input.string(
     "Auto",
     "Containment Direction",
     options = [
         "Auto",
         "Previous Structure",
         "Current Expansion"
     ],
     group = groupContainment)


groupEngine = "04 - Engine"

maxNormalizedBars = input.int(
     500,
     "Maximum Normalized Bars",
     minval = 50,
     maxval = 2000,
     group = groupEngine)


groupVisual = "05 - Visual"

topColor = input.color(
     color.red,
     "Top Fractal",
     group = groupVisual)

bottomColor = input.color(
     color.lime,
     "Bottom Fractal",
     group = groupVisual)

containmentColor = input.color(
     color.orange,
     "Containment",
     group = groupVisual)

normalizedColor = input.color(
     color.aqua,
     "Normalized Bar",
     group = groupVisual)

debugColor = input.color(
     color.yellow,
     "Debug",
     group = groupVisual)


//=============================================================================
// 02. CONSTANTS
//=============================================================================

int DIR_NONE = 0
int DIR_BULL = 1
int DIR_BEAR = -1

int FRACTAL_NONE = 0
int FRACTAL_TOP = 1
int FRACTAL_BOTTOM = -1


//=============================================================================
// 03. ENGINE OUTPUT
//
// This hidden plot guarantees that TradingView recognizes the script as a
// valid indicator even if all visible output switches are disabled.
//=============================================================================

plot(
     na,
     title = "TC Chan Core",
     display = display.none)


//=============================================================================
// 04. RAW DATA
//=============================================================================

float rawOpen = open
float rawHigh = high
float rawLow = low
float rawClose = close
float rawVolume = volume


//=============================================================================
// 05. NORMALIZED BAR ARRAYS
//=============================================================================

var array<float> normOpen = array.new_float()
var array<float> normHigh = array.new_float()
var array<float> normLow = array.new_float()
var array<float> normClose = array.new_float()
var array<float> normVolume = array.new_float()

var array<int> normSourceBar = array.new_int()
var array<int> normDirection = array.new_int()


//=============================================================================
// 06. STRUCTURAL STATE
//=============================================================================

var int structureDirection = DIR_NONE

var int lastFractalType = FRACTAL_NONE
var float lastFractalPrice = na
var int lastFractalSourceBar = na

var int topCount = 0
var int bottomCount = 0
var int containmentCount = 0
var int normalizedCount = 0


//=============================================================================
// 07. CURRENT BAR FLAGS
//
// These must be reset on every bar.
//=============================================================================

bool newNormalizedBar = false
bool containmentDetected = false
bool topFractalDetected = false
bool bottomFractalDetected = false


//=============================================================================
// 08. HELPER FUNCTIONS
//=============================================================================

isContained(
     float currentHigh,
     float currentLow,
     float previousHigh,
     float previousLow) =>

    bool currentContainsPrevious =
         currentHigh >= previousHigh and
         currentLow <= previousLow

    bool previousContainsCurrent =
         previousHigh >= currentHigh and
         previousLow <= currentLow

    currentContainsPrevious or previousContainsCurrent


getDirection(
     float currentHigh,
     float currentLow,
     float previousHigh,
     float previousLow,
     int previousDirection) =>

    int result = previousDirection

    bool bullish =
         currentHigh > previousHigh and
         currentLow > previousLow

    bool bearish =
         currentHigh < previousHigh and
         currentLow < previousLow

    if directionMode == "Current Expansion"

        if bullish
            result := DIR_BULL
        else if bearish
            result := DIR_BEAR

    else

        if bullish
            result := DIR_BULL
        else if bearish
            result := DIR_BEAR

    result


addNormalized(
     float o,
     float h,
     float l,
     float c,
     float v,
     int sourceBar,
     int direction) =>

    array.push(normOpen, o)
    array.push(normHigh, h)
    array.push(normLow, l)
    array.push(normClose, c)
    array.push(normVolume, v)
    array.push(normSourceBar, sourceBar)
    array.push(normDirection, direction)


updateNormalized(
     float o,
     float h,
     float l,
     float c,
     float v,
     int sourceBar,
     int direction) =>

    int index = array.size(normHigh) - 1

    if index >= 0

        array.set(normOpen, index, o)
        array.set(normHigh, index, h)
        array.set(normLow, index, l)
        array.set(normClose, index, c)
        array.set(normVolume, index, v)
        array.set(normSourceBar, index, sourceBar)
        array.set(normDirection, index, direction)


trimNormalized() =>

    while array.size(normHigh) > maxNormalizedBars

        array.shift(normOpen)
        array.shift(normHigh)
        array.shift(normLow)
        array.shift(normClose)
        array.shift(normVolume)
        array.shift(normSourceBar)
        array.shift(normDirection)


//=============================================================================
// 09. NORMALIZED BAR ENGINE
//=============================================================================

if barstate.isconfirmed

    int currentSize = array.size(normHigh)

    //-------------------------------------------------------------------------
    // FIRST NORMALIZED BAR
    //-------------------------------------------------------------------------

    if currentSize == 0

        addNormalized(
             rawOpen,
             rawHigh,
             rawLow,
             rawClose,
             rawVolume,
             bar_index,
             DIR_NONE)

        normalizedCount += 1
        newNormalizedBar := true


    //-------------------------------------------------------------------------
    // EXISTING NORMALIZED STRUCTURE
    //-------------------------------------------------------------------------

    else

        int lastIndex =
             array.size(normHigh) - 1

        float prevHigh =
             array.get(normHigh, lastIndex)

        float prevLow =
             array.get(normLow, lastIndex)

        float prevOpen =
             array.get(normOpen, lastIndex)

        float prevVolume =
             array.get(normVolume, lastIndex)

        int prevDirection =
             array.get(normDirection, lastIndex)


        //=====================================================================
        // CONTAINMENT CHECK
        //=====================================================================

        bool contained =
             isContained(
                 rawHigh,
                 rawLow,
                 prevHigh,
                 prevLow)


        if contained

            containmentDetected := true
            containmentCount += 1


            int newDirection =
                 getDirection(
                     rawHigh,
                     rawLow,
                     prevHigh,
                     prevLow,
                     prevDirection)


            float mergedHigh = na
            float mergedLow = na


            //=================================================================
            // BULLISH STRUCTURE
            //=================================================================

            if newDirection == DIR_BULL

                mergedHigh =
                     math.max(
                         rawHigh,
                         prevHigh)

                mergedLow =
                     math.max(
                         rawLow,
                         prevLow)


            //=================================================================
            // BEARISH STRUCTURE
            //=================================================================

            else if newDirection == DIR_BEAR

                mergedHigh =
                     math.min(
                         rawHigh,
                         prevHigh)

                mergedLow =
                     math.min(
                         rawLow,
                         prevLow)


            //=================================================================
            // UNKNOWN DIRECTION
            //=================================================================

            else

                mergedHigh =
                     math.max(
                         rawHigh,
                         prevHigh)

                mergedLow =
                     math.min(
                         rawLow,
                         prevLow)


            updateNormalized(
                 prevOpen,
                 mergedHigh,
                 mergedLow,
                 rawClose,
                 prevVolume + rawVolume,
                 bar_index,
                 newDirection)

            structureDirection :=
                 newDirection


        //=====================================================================
        // NO CONTAINMENT
        //=====================================================================

        else

            int newDirection =
                 getDirection(
                     rawHigh,
                     rawLow,
                     prevHigh,
                     prevLow,
                     prevDirection)


            addNormalized(
                 rawOpen,
                 rawHigh,
                 rawLow,
                 rawClose,
                 rawVolume,
                 bar_index,
                 newDirection)

            normalizedCount += 1
            newNormalizedBar := true

            structureDirection :=
                 newDirection


    trimNormalized()


//=============================================================================
// 10. CONTAINMENT VISUAL
//=============================================================================

plotshape(
     showContainment and containmentDetected,
     title = "Containment",
     style = shape.circle,
     location = location.abovebar,
     color = containmentColor,
     size = size.tiny)


//=============================================================================
// 11. NORMALIZED BAR VISUAL
//=============================================================================

plotshape(
     showNormalized and newNormalizedBar,
     title = "Normalized Bar",
     style = shape.circle,
     location = location.bottom,
     color = normalizedColor,
     size = size.tiny)


//=============================================================================
// 12. NORMALIZED FRACTAL ENGINE
//
// We need at least:
//
//     N-2
//     N-1  <- candidate
//     N
//
// The middle normalized bar is tested.
//=============================================================================

if barstate.isconfirmed and newNormalizedBar

    int n =
         array.size(normHigh)

    if n >= 3

        int leftIndex = n - 3
        int centerIndex = n - 2
        int rightIndex = n - 1


        float leftHigh =
             array.get(normHigh, leftIndex)

        float centerHigh =
             array.get(normHigh, centerIndex)

        float rightHigh =
             array.get(normHigh, rightIndex)


        float leftLow =
             array.get(normLow, leftIndex)

        float centerLow =
             array.get(normLow, centerIndex)

        float rightLow =
             array.get(normLow, rightIndex)


        //=====================================================================
        // STRICT
        //=====================================================================

        bool strictTop =
             centerHigh > leftHigh and
             centerHigh > rightHigh

        bool strictBottom =
             centerLow < leftLow and
             centerLow < rightLow


        //=====================================================================
        // PRACTICAL
        //=====================================================================

        bool practicalTop =
             centerHigh >= leftHigh and
             centerHigh >= rightHigh and
             (
                 centerHigh > leftHigh or
                 centerHigh > rightHigh
             )

        bool practicalBottom =
             centerLow <= leftLow and
             centerLow <= rightLow and
             (
                 centerLow < leftLow or
                 centerLow < rightLow
             )


        bool isTop =
             fractalMode == "Strict"
             ? strictTop
             : practicalTop

        bool isBottom =
             fractalMode == "Strict"
             ? strictBottom
             : practicalBottom


        int centerSourceBar =
             array.get(
                 normSourceBar,
                 centerIndex)


        //=====================================================================
        // TOP CANDIDATE
        //=====================================================================

        if isTop

            bool allowed = true

            if requireAlternation and
               lastFractalType == FRACTAL_TOP

                if centerHigh <= lastFractalPrice

                    allowed := false


            if not na(lastFractalSourceBar)

                int distance =
                     centerSourceBar -
                     lastFractalSourceBar

                if distance < minFractalDistance

                    allowed := false


            if allowed

                topFractalDetected := true

                topCount += 1

                lastFractalType :=
                     FRACTAL_TOP

                lastFractalPrice :=
                     centerHigh

                lastFractalSourceBar :=
                     centerSourceBar


                if showFractals

                    label.new(
                         x = centerSourceBar,
                         y = centerHigh,
                         xloc = xloc.bar_index,
                         style = label.style_label_down,
                         text = "TOP",
                         color = topColor,
                         textcolor = color.white,
                         size = size.tiny)


        //=====================================================================
        // BOTTOM CANDIDATE
        //=====================================================================

        if isBottom

            bool allowed = true

            if requireAlternation and
               lastFractalType == FRACTAL_BOTTOM

                if centerLow >= lastFractalPrice

                    allowed := false


            if not na(lastFractalSourceBar)

                int distance =
                     centerSourceBar -
                     lastFractalSourceBar

                if distance < minFractalDistance

                    allowed := false


            if allowed

                bottomFractalDetected := true

                bottomCount += 1

                lastFractalType :=
                     FRACTAL_BOTTOM

                lastFractalPrice :=
                     centerLow

                lastFractalSourceBar :=
                     centerSourceBar


                if showFractals

                    label.new(
                         x = centerSourceBar,
                         y = centerLow,
                         xloc = xloc.bar_index,
                         style = label.style_label_up,
                         text = "BOTTOM",
                         color = bottomColor,
                         textcolor = color.white,
                         size = size.tiny)


//=============================================================================
// 13. ALERTS
//=============================================================================

alertcondition(
     topFractalDetected,
     title = "TC Chan M2 - TOP",
     message = "TC Chan Pro M2: TOP fractal confirmed")

alertcondition(
     bottomFractalDetected,
     title = "TC Chan M2 - BOTTOM",
     message = "TC Chan Pro M2: BOTTOM fractal confirmed")

alertcondition(
     containmentDetected,
     title = "TC Chan M2 - CONTAINMENT",
     message = "TC Chan Pro M2: containment detected")


//=============================================================================
// 14. DEBUG TABLE
//=============================================================================

var table debugTable =
     table.new(
         position.top_right,
         2,
         15,
         border_width = 1)


if barstate.islast

    if showDebug

        table.cell(
             debugTable,
             0,
             0,
             "TC CHAN PRO",
             text_color = color.white)

        table.cell(
             debugTable,
             1,
             0,
             "M2.0.1",
             text_color = debugColor)


        table.cell(
             debugTable,
             0,
             1,
             "Normalized Bars")

        table.cell(
             debugTable,
             1,
             1,
             str.tostring(
                 array.size(normHigh)))


        table.cell(
             debugTable,
             0,
             2,
             "Containments")

        table.cell(
             debugTable,
             1,
             2,
             str.tostring(
                 containmentCount))


        table.cell(
             debugTable,
             0,
             3,
             "Top Count")

        table.cell(
             debugTable,
             1,
             3,
             str.tostring(
                 topCount))


        table.cell(
             debugTable,
             0,
             4,
             "Bottom Count")

        table.cell(
             debugTable,
             1,
             4,
             str.tostring(
                 bottomCount))


        table.cell(
             debugTable,
             0,
             5,
             "Direction")

        table.cell(
             debugTable,
             1,
             5,
             structureDirection == DIR_BULL
                 ? "BULL"
                 : structureDirection == DIR_BEAR
                 ? "BEAR"
                 : "NONE")


        table.cell(
             debugTable,
             0,
             6,
             "Last Fractal")

        table.cell(
             debugTable,
             1,
             6,
             lastFractalType == FRACTAL_TOP
                 ? "TOP"
                 : lastFractalType == FRACTAL_BOTTOM
                 ? "BOTTOM"
                 : "NONE")


        table.cell(
             debugTable,
             0,
             7,
             "Last Price")

        table.cell(
             debugTable,
             1,
             7,
             na(lastFractalPrice)
                 ? "NA"
                 : str.tostring(
                     lastFractalPrice))


        table.cell(
             debugTable,
             0,
             8,
             "Source Bar")

        table.cell(
             debugTable,
             1,
             8,
             na(lastFractalSourceBar)
                 ? "NA"
                 : str.tostring(
                     lastFractalSourceBar))


        table.cell(
             debugTable,
             0,
             9,
             "New Normalized")

        table.cell(
             debugTable,
             1,
             9,
             newNormalizedBar
                 ? "YES"
                 : "NO")


        table.cell(
             debugTable,
             0,
             10,
             "Containment")

        table.cell(
             debugTable,
             1,
             10,
             containmentDetected
                 ? "YES"
                 : "NO")


        table.cell(
             debugTable,
             0,
             11,
             "Norm High")

        table.cell(
             debugTable,
             1,
             11,
             array.size(normHigh) > 0
                 ? str.tostring(
                     array.get(
                         normHigh,
                         array.size(normHigh) - 1))
                 : "NA")


        table.cell(
             debugTable,
             0,
             12,
             "Norm Low")

        table.cell(
             debugTable,
             1,
             12,
             array.size(normLow) > 0
                 ? str.tostring(
                     array.get(
                         normLow,
                         array.size(normLow) - 1))
                 : "NA")


        table.cell(
             debugTable,
             0,
             13,
             "Norm Direction")

        table.cell(
             debugTable,
             1,
             13,
             array.size(normDirection) > 0
                 ? (
                     array.get(
                         normDirection,
                         array.size(normDirection) - 1) == DIR_BULL
                     ? "BULL"
                     : array.get(
                         normDirection,
                         array.size(normDirection) - 1) == DIR_BEAR
                     ? "BEAR"
                     : "NONE"
                   )
                 : "NA")


        table.cell(
             debugTable,
             0,
             14,
             "Version")

        table.cell(
             debugTable,
             1,
             14,
             "M2.0.1")


//=============================================================================
// 15. END
//=============================================================================
