//@version=6
indicator("TC Chan Pro M3.0.1 - Stroke Engine", shorttitle="TC Chan M3", overlay=true, max_labels_count=500, max_lines_count=500)

//=============================================================================
// TC CHAN PRO
// M3.0.1
//
// M1 : Raw K
// M2 : Containment + Normalized Bar + Fractal
// M3 : Stroke Engine
//
// Design goal:
// - Consistent
// - Programmable
// - Maintainable
// - Practical
//
// This is a programmable interpretation of Chan-style structure.
// It is not intended to reproduce one fixed traditional rule set.
//=============================================================================


//=============================================================================
// 01. INPUTS
//=============================================================================

groupGeneral = "01 - General"

showFractals = input.bool(true, "Show Fractals", group=groupGeneral)
showContainment = input.bool(false, "Show Containment", group=groupGeneral)
showStrokes = input.bool(true, "Show Strokes", group=groupGeneral)
showStrokeLabels = input.bool(true, "Show Stroke Labels", group=groupGeneral)
showDebug = input.bool(false, "Debug Mode", group=groupGeneral)


groupFractal = "02 - Fractal"

fractalMode = input.string("Practical", "Fractal Mode", options=["Strict", "Practical"], group=groupFractal)
requireAlternation = input.bool(true, "Require Fractal Alternation", group=groupFractal)
minFractalDistance = input.int(1, "Minimum Fractal Distance", minval=0, maxval=100, group=groupFractal)


groupStroke = "03 - Stroke"

minStrokeSourceBars = input.int(2, "Minimum Source Bars Per Stroke", minval=1, maxval=100, group=groupStroke)
minStrokePriceRatio = input.float(0.0, "Minimum Stroke Size %", minval=0.0, maxval=100.0, step=0.1, group=groupStroke)
replaceWeakFractal = input.bool(true, "Replace Weak Same-Type Fractal", group=groupStroke)


groupEngine = "04 - Engine"

maxNormalizedBars = input.int(500, "Maximum Normalized Bars", minval=100, maxval=2000, group=groupEngine)
maxStrokes = input.int(200, "Maximum Stored Strokes", minval=20, maxval=1000, group=groupEngine)


groupVisual = "05 - Visual"

topColor = input.color(color.red, "Top Fractal", group=groupVisual)
bottomColor = input.color(color.lime, "Bottom Fractal", group=groupVisual)
upStrokeColor = input.color(color.lime, "Up Stroke", group=groupVisual)
downStrokeColor = input.color(color.red, "Down Stroke", group=groupVisual)
containmentColor = input.color(color.orange, "Containment", group=groupVisual)
debugColor = input.color(color.yellow, "Debug", group=groupVisual)


//=============================================================================
// 02. CONSTANTS
//=============================================================================

int DIR_NONE = 0
int DIR_BULL = 1
int DIR_BEAR = -1

int FRACTAL_NONE = 0
int FRACTAL_TOP = 1
int FRACTAL_BOTTOM = -1


//=============================================================================
// 03. VALID INDICATOR OUTPUT
//=============================================================================

plot(na, title="TC Chan Core", display=display.none)


//=============================================================================
// 04. RAW DATA
//=============================================================================

float rawOpen = open
float rawHigh = high
float rawLow = low
float rawClose = close
float rawVolume = volume


//=============================================================================
// 05. NORMALIZED BAR ARRAYS
//=============================================================================

var array<float> normOpen = array.new_float()
var array<float> normHigh = array.new_float()
var array<float> normLow = array.new_float()
var array<float> normClose = array.new_float()
var array<float> normVolume = array.new_float()

var array<int> normSourceBar = array.new_int()
var array<int> normDirection = array.new_int()


//=============================================================================
// 06. FRACTAL STATE
//=============================================================================

var int candidateType = FRACTAL_NONE
var float candidatePrice = na
var int candidateSourceBar = na

var int anchorType = FRACTAL_NONE
var float anchorPrice = na
var int anchorSourceBar = na

var int lastFractalType = FRACTAL_NONE
var float lastFractalPrice = na
var int lastFractalSourceBar = na


//=============================================================================
// 07. STROKE ARRAYS
//=============================================================================

var array<int> strokeDirection = array.new_int()

var array<float> strokeStartPrice = array.new_float()
var array<float> strokeEndPrice = array.new_float()

var array<int> strokeStartBar = array.new_int()
var array<int> strokeEndBar = array.new_int()

var array<float> strokeHigh = array.new_float()
var array<float> strokeLow = array.new_float()

var array<float> strokePercent = array.new_float()


//=============================================================================
// 08. GLOBAL STATE
//=============================================================================

var int strokeCount = 0
var int containmentCount = 0
var int normalizedCount = 0

var int currentStrokeDirection = DIR_NONE


//=============================================================================
// 09. CURRENT BAR EVENTS
//=============================================================================

bool newNormalizedBar = false
bool containmentDetected = false

bool topFractalDetected = false
bool bottomFractalDetected = false

bool newStrokeDetected = false


//=============================================================================
// 10. HELPER FUNCTIONS
//=============================================================================

isContained(float currentHigh, float currentLow, float previousHigh, float previousLow) =>
    bool currentContainsPrevious = currentHigh >= previousHigh and currentLow <= previousLow
    bool previousContainsCurrent = previousHigh >= currentHigh and previousLow <= currentLow
    currentContainsPrevious or previousContainsCurrent


getDirection(float currentHigh, float currentLow, float previousHigh, float previousLow, int previousDirection) =>
    int result = previousDirection
    bool bullish = currentHigh > previousHigh and currentLow > previousLow
    bool bearish = currentHigh < previousHigh and currentLow < previousLow

    if bullish
        result := DIR_BULL
    else if bearish
        result := DIR_BEAR

    result


addNormalized(float o, float h, float l, float c, float v, int sourceBar, int direction) =>
    array.push(normOpen, o)
    array.push(normHigh, h)
    array.push(normLow, l)
    array.push(normClose, c)
    array.push(normVolume, v)
    array.push(normSourceBar, sourceBar)
    array.push(normDirection, direction)


updateNormalized(float o, float h, float l, float c, float v, int sourceBar, int direction) =>
    int index = array.size(normHigh) - 1

    if index >= 0
        array.set(normOpen, index, o)
        array.set(normHigh, index, h)
        array.set(normLow, index, l)
        array.set(normClose, index, c)
        array.set(normVolume, index, v)
        array.set(normSourceBar, index, sourceBar)
        array.set(normDirection, index, direction)


trimNormalized() =>
    while array.size(normHigh) > maxNormalizedBars
        array.shift(normOpen)
        array.shift(normHigh)
        array.shift(normLow)
        array.shift(normClose)
        array.shift(normVolume)
        array.shift(normSourceBar)
        array.shift(normDirection)


addStroke(int direction, float startPrice, float endPrice, int startBar, int endBar) =>
    float hi = math.max(startPrice, endPrice)
    float lo = math.min(startPrice, endPrice)
    float pct = lo != 0.0 ? math.abs(endPrice - startPrice) / math.abs(lo) * 100.0 : 0.0

    array.push(strokeDirection, direction)
    array.push(strokeStartPrice, startPrice)
    array.push(strokeEndPrice, endPrice)
    array.push(strokeStartBar, startBar)
    array.push(strokeEndBar, endBar)
    array.push(strokeHigh, hi)
    array.push(strokeLow, lo)
    array.push(strokePercent, pct)


trimStrokes() =>
    while array.size(strokeDirection) > maxStrokes
        array.shift(strokeDirection)
        array.shift(strokeStartPrice)
        array.shift(strokeEndPrice)
        array.shift(strokeStartBar)
        array.shift(strokeEndBar)
        array.shift(strokeHigh)
        array.shift(strokeLow)
        array.shift(strokePercent)


//=============================================================================
// 11. NORMALIZED BAR ENGINE
//=============================================================================

if barstate.isconfirmed

    int normSize = array.size(normHigh)

    if normSize == 0

        addNormalized(rawOpen, rawHigh, rawLow, rawClose, rawVolume, bar_index, DIR_NONE)

        normalizedCount += 1
        newNormalizedBar := true

    else

        int lastIndex = array.size(normHigh) - 1

        float prevHigh = array.get(normHigh, lastIndex)
        float prevLow = array.get(normLow, lastIndex)
        float prevOpen = array.get(normOpen, lastIndex)
        float prevVolume = array.get(normVolume, lastIndex)

        int prevDirection = array.get(normDirection, lastIndex)

        bool contained = isContained(rawHigh, rawLow, prevHigh, prevLow)

        if contained

            containmentDetected := true
            containmentCount += 1

            int direction = getDirection(rawHigh, rawLow, prevHigh, prevLow, prevDirection)

            float mergedHigh = na
            float mergedLow = na

            if direction == DIR_BULL

                mergedHigh := math.max(rawHigh, prevHigh)
                mergedLow := math.max(rawLow, prevLow)

            else if direction == DIR_BEAR

                mergedHigh := math.min(rawHigh, prevHigh)
                mergedLow := math.min(rawLow, prevLow)

            else

                mergedHigh := math.max(rawHigh, prevHigh)
                mergedLow := math.min(rawLow, prevLow)

            updateNormalized(prevOpen, mergedHigh, mergedLow, rawClose, prevVolume + rawVolume, bar_index, direction)

        else

            int direction = getDirection(rawHigh, rawLow, prevHigh, prevLow, prevDirection)

            addNormalized(rawOpen, rawHigh, rawLow, rawClose, rawVolume, bar_index, direction)

            normalizedCount += 1
            newNormalizedBar := true

    trimNormalized()


//=============================================================================
// 12. CONTAINMENT DISPLAY
//=============================================================================

plotshape(showContainment and containmentDetected, title="Containment", style=shape.circle, location=location.abovebar, color=containmentColor, size=size.tiny)


//=============================================================================
// 13. FRACTAL ENGINE
//=============================================================================

if barstate.isconfirmed and newNormalizedBar

    int n = array.size(normHigh)

    if n >= 3

        int left = n - 3
        int center = n - 2
        int right = n - 1

        float leftHigh = array.get(normHigh, left)
        float centerHigh = array.get(normHigh, center)
        float rightHigh = array.get(normHigh, right)

        float leftLow = array.get(normLow, left)
        float centerLow = array.get(normLow, center)
        float rightLow = array.get(normLow, right)

        bool strictTop = centerHigh > leftHigh and centerHigh > rightHigh
        bool strictBottom = centerLow < leftLow and centerLow < rightLow

        bool practicalTop = centerHigh >= leftHigh and centerHigh >= rightHigh and (centerHigh > leftHigh or centerHigh > rightHigh)
        bool practicalBottom = centerLow <= leftLow and centerLow <= rightLow and (centerLow < leftLow or centerLow < rightLow)

        bool isTop = fractalMode == "Strict" ? strictTop : practicalTop
        bool isBottom = fractalMode == "Strict" ? strictBottom : practicalBottom

        int sourceBar = array.get(normSourceBar, center)

        //=====================================================================
        // TOP FRACTAL
        //=====================================================================

        if isTop

            topFractalDetected := true

            float price = centerHigh

            bool distanceOK = na(lastFractalSourceBar) or sourceBar - lastFractalSourceBar >= minFractalDistance

            bool alternationOK = not requireAlternation or lastFractalType != FRACTAL_TOP

            if distanceOK and alternationOK

                lastFractalType := FRACTAL_TOP
                lastFractalPrice := price
                lastFractalSourceBar := sourceBar

                if candidateType == FRACTAL_NONE

                    candidateType := FRACTAL_TOP
                    candidatePrice := price
                    candidateSourceBar := sourceBar

                else if candidateType == FRACTAL_TOP

                    if replaceWeakFractal and price > candidatePrice

                        candidatePrice := price
                        candidateSourceBar := sourceBar

                else

                    candidateType := FRACTAL_TOP
                    candidatePrice := price
                    candidateSourceBar := sourceBar


        //=====================================================================
        // BOTTOM FRACTAL
        //=====================================================================

        if isBottom

            bottomFractalDetected := true

            float price = centerLow

            bool distanceOK = na(lastFractalSourceBar) or sourceBar - lastFractalSourceBar >= minFractalDistance

            bool alternationOK = not requireAlternation or lastFractalType != FRACTAL_BOTTOM

            if distanceOK and alternationOK

                lastFractalType := FRACTAL_BOTTOM
                lastFractalPrice := price
                lastFractalSourceBar := sourceBar

                if candidateType == FRACTAL_NONE

                    candidateType := FRACTAL_BOTTOM
                    candidatePrice := price
                    candidateSourceBar := sourceBar

                else if candidateType == FRACTAL_BOTTOM

                    if replaceWeakFractal and price < candidatePrice

                        candidatePrice := price
                        candidateSourceBar := sourceBar

                else

                    candidateType := FRACTAL_BOTTOM
                    candidatePrice := price
                    candidateSourceBar := sourceBar


//=============================================================================
// 14. FRACTAL DISPLAY
//=============================================================================

plotshape(showFractals and topFractalDetected, title="Top Fractal", style=shape.triangledown, location=location.abovebar, color=topColor, size=size.tiny, offset=-1)

plotshape(showFractals and bottomFractalDetected, title="Bottom Fractal", style=shape.triangleup, location=location.belowbar, color=bottomColor, size=size.tiny, offset=-1)


//=============================================================================
// 15. INITIAL ANCHOR
//=============================================================================

if barstate.isconfirmed

    if anchorType == FRACTAL_NONE and candidateType != FRACTAL_NONE

        anchorType := candidateType
        anchorPrice := candidatePrice
        anchorSourceBar := candidateSourceBar


//=============================================================================
// 16. STROKE ENGINE
//
// Valid sequence:
//
// TOP -> BOTTOM = Bear Stroke
// BOTTOM -> TOP = Bull Stroke
//=============================================================================

if barstate.isconfirmed

    //=========================================================================
    // TOP -> BOTTOM
    //=========================================================================

    if anchorType == FRACTAL_TOP and candidateType == FRACTAL_BOTTOM and candidateSourceBar > anchorSourceBar

        int distance = candidateSourceBar - anchorSourceBar

        float movePercent = anchorPrice != 0.0 ? math.abs(candidatePrice - anchorPrice) / math.abs(anchorPrice) * 100.0 : 0.0

        bool distanceValid = distance >= minStrokeSourceBars
        bool priceValid = movePercent >= minStrokePriceRatio

        if distanceValid and priceValid

            addStroke(DIR_BEAR, anchorPrice, candidatePrice, anchorSourceBar, candidateSourceBar)

            trimStrokes()

            strokeCount += 1
            newStrokeDetected := true
            currentStrokeDirection := DIR_BEAR

            if showStrokes

                line.new(anchorSourceBar, anchorPrice, candidateSourceBar, candidatePrice, xloc=xloc.bar_index, extend=extend.none, color=downStrokeColor, width=2)

            if showStrokeLabels

                label.new(candidateSourceBar, candidatePrice, "↓B" + str.tostring(strokeCount), xloc=xloc.bar_index, style=label.style_label_up, color=downStrokeColor, textcolor=color.white, size=size.tiny)

            anchorType := FRACTAL_BOTTOM
            anchorPrice := candidatePrice
            anchorSourceBar := candidateSourceBar


    //=========================================================================
    // BOTTOM -> TOP
    //=========================================================================

    if anchorType == FRACTAL_BOTTOM and candidateType == FRACTAL_TOP and candidateSourceBar > anchorSourceBar

        int distance = candidateSourceBar - anchorSourceBar

        float movePercent = anchorPrice != 0.0 ? math.abs(candidatePrice - anchorPrice) / math.abs(anchorPrice) * 100.0 : 0.0

        bool distanceValid = distance >= minStrokeSourceBars
        bool priceValid = movePercent >= minStrokePriceRatio

        if distanceValid and priceValid

            addStroke(DIR_BULL, anchorPrice, candidatePrice, anchorSourceBar, candidateSourceBar)

            trimStrokes()

            strokeCount += 1
            newStrokeDetected := true
            currentStrokeDirection := DIR_BULL

            if showStrokes

                line.new(anchorSourceBar, anchorPrice, candidateSourceBar, candidatePrice, xloc=xloc.bar_index, extend=extend.none, color=upStrokeColor, width=2)

            if showStrokeLabels

                label.new(candidateSourceBar, candidatePrice, "↑B" + str.tostring(strokeCount), xloc=xloc.bar_index, style=label.style_label_down, color=upStrokeColor, textcolor=color.white, size=size.tiny)

            anchorType := FRACTAL_TOP
            anchorPrice := candidatePrice
            anchorSourceBar := candidateSourceBar


//=============================================================================
// 17. ALERTS
//=============================================================================

alertcondition(newStrokeDetected and currentStrokeDirection == DIR_BULL, title="TC Chan M3 - Bull Stroke", message="TC Chan Pro M3: New bullish stroke confirmed")

alertcondition(newStrokeDetected and currentStrokeDirection == DIR_BEAR, title="TC Chan M3 - Bear Stroke", message="TC Chan Pro M3: New bearish stroke confirmed")

alertcondition(topFractalDetected, title="TC Chan M3 - Top Fractal", message="TC Chan Pro M3: Top fractal detected")

alertcondition(bottomFractalDetected, title="TC Chan M3 - Bottom Fractal", message="TC Chan Pro M3: Bottom fractal detected")

alertcondition(containmentDetected, title="TC Chan M3 - Containment", message="TC Chan Pro M3: Containment detected")


//=============================================================================
// 18. DEBUG TABLE
//=============================================================================

var table debugTable = table.new(position.top_right, 2, 18, border_width=1)

if barstate.islast

    if showDebug

        table.cell(debugTable, 0, 0, "TC CHAN PRO", text_color=color.white)
        table.cell(debugTable, 1, 0, "M3.0.1", text_color=debugColor)

        table.cell(debugTable, 0, 1, "Normalized Bars")
        table.cell(debugTable, 1, 1, str.tostring(array.size(normHigh)))

        table.cell(debugTable, 0, 2, "Containments")
        table.cell(debugTable, 1, 2, str.tostring(containmentCount))

        table.cell(debugTable, 0, 3, "Top Event")
        table.cell(debugTable, 1, 3, topFractalDetected ? "YES" : "NO")

        table.cell(debugTable, 0, 4, "Bottom Event")
        table.cell(debugTable, 1, 4, bottomFractalDetected ? "YES" : "NO")

        table.cell(debugTable, 0, 5, "Candidate")
        table.cell(debugTable, 1, 5, candidateType == FRACTAL_TOP ? "TOP" : candidateType == FRACTAL_BOTTOM ? "BOTTOM" : "NONE")

        table.cell(debugTable, 0, 6, "Candidate Price")
        table.cell(debugTable, 1, 6, na(candidatePrice) ? "NA" : str.tostring(candidatePrice))

        table.cell(debugTable, 0, 7, "Candidate Bar")
        table.cell(debugTable, 1, 7, na(candidateSourceBar) ? "NA" : str.tostring(candidateSourceBar))

        table.cell(debugTable, 0, 8, "Anchor")
        table.cell(debugTable, 1, 8, anchorType == FRACTAL_TOP ? "TOP" : anchorType == FRACTAL_BOTTOM ? "BOTTOM" : "NONE")

        table.cell(debugTable, 0, 9, "Anchor Price")
        table.cell(debugTable, 1, 9, na(anchorPrice) ? "NA" : str.tostring(anchorPrice))

        table.cell(debugTable, 0, 10, "Anchor Bar")
        table.cell(debugTable, 1, 10, na(anchorSourceBar) ? "NA" : str.tostring(anchorSourceBar))

        table.cell(debugTable, 0, 11, "Strokes")
        table.cell(debugTable, 1, 11, str.tostring(strokeCount))

        table.cell(debugTable, 0, 12, "Last Direction")
        table.cell(debugTable, 1, 12, currentStrokeDirection == DIR_BULL ? "BULL" : currentStrokeDirection == DIR_BEAR ? "BEAR" : "NONE")

        table.cell(debugTable, 0, 13, "Last Stroke %")
        table.cell(debugTable, 1, 13, array.size(strokePercent) > 0 ? str.tostring(array.get(strokePercent, array.size(strokePercent) - 1)) : "NA")

        table.cell(debugTable, 0, 14, "Last Stroke High")
        table.cell(debugTable, 1, 14, array.size(strokeHigh) > 0 ? str.tostring(array.get(strokeHigh, array.size(strokeHigh) - 1)) : "NA")

        table.cell(debugTable, 0, 15, "Last Stroke Low")
        table.cell(debugTable, 1, 15, array.size(strokeLow) > 0 ? str.tostring(array.get(strokeLow, array.size(strokeLow) - 1)) : "NA")

        table.cell(debugTable, 0, 16, "New Stroke")
        table.cell(debugTable, 1, 16, newStrokeDetected ? "YES" : "NO")

        table.cell(debugTable, 0, 17, "Version")
        table.cell(debugTable, 1, 17, "M3.0.1")


//=============================================================================
// END
//=============================================================================
