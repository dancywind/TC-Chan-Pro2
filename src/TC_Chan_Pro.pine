//@version=6
indicator("TC Chan Pro M1.2", shorttitle="TC-M12", overlay=true, max_lines_count=500, max_labels_count=500)

//=============================================================================
// TC CHAN PRO
// M1.2
//
// Raw K
//   ↓
// Containment
//   ↓
// Direction
//   ↓
// GG / DD
//   ↓
// Normalized K
//
// 本版本只處理「包含關係」。
// 尚未加入：頂分型、底分型、筆。
//=============================================================================


//=============================================================================
// 01 INPUT
//=============================================================================

groupGeneral = "01 General"
groupVisual = "02 Visual"

showNormalized = input.bool(
     true,
     "Show Normalized K",
     group=groupGeneral)

showMergeLabel = input.bool(
     true,
     "Show Merge Label",
     group=groupGeneral)

showSourceLabel = input.bool(
     true,
     "Show Source H/L",
     group=groupGeneral)

upColor = input.color(
     color.lime,
     "Up Direction",
     group=groupVisual)

downColor = input.color(
     color.red,
     "Down Direction",
     group=groupVisual)

neutralColor = input.color(
     color.gray,
     "Neutral Direction",
     group=groupVisual)


//=============================================================================
// 02 CONSTANTS
//=============================================================================

int DIR_NONE = 0
int DIR_UP = 1
int DIR_DOWN = -1


//=============================================================================
// 03 REQUIRED OUTPUT
//=============================================================================

plot(
     na,
     title="TC Chan M1.2 Core",
     display=display.none)


//=============================================================================
// 04 NORMALIZED K DATA
//=============================================================================

var normOpen = array.new_float()
var normHigh = array.new_float()
var normLow = array.new_float()
var normClose = array.new_float()

var normHighBar = array.new_int()
var normLowBar = array.new_int()

var normStartBar = array.new_int()
var normEndBar = array.new_int()

var normDirection = array.new_int()
var normMergeCount = array.new_int()


//=============================================================================
// 05 STATISTICS
//=============================================================================

var int rawCount = 0
var int totalMerges = 0


//=============================================================================
// 06 DIRECTION FUNCTION
//=============================================================================

getDirection(
     float currentHigh,
     float currentLow,
     float previousHigh,
     float previousLow,
     int previousDirection) =>

    int result = previousDirection

    if currentHigh > previousHigh and currentLow > previousLow
        result := DIR_UP
    else if currentHigh < previousHigh and currentLow < previousLow
        result := DIR_DOWN

    result


//=============================================================================
// 07 CONTAINMENT FUNCTION
//=============================================================================

isContained(
     float currentHigh,
     float currentLow,
     float previousHigh,
     float previousLow) =>

    bool currentContainsPrevious =
         currentHigh >= previousHigh and currentLow <= previousLow

    bool previousContainsCurrent =
         previousHigh >= currentHigh and previousLow <= currentLow

    currentContainsPrevious or previousContainsCurrent


//=============================================================================
// 08 ADD NORMALIZED K
//=============================================================================

addNormalized(
     float o,
     float h,
     float l,
     float c,
     int hBar,
     int lBar,
     int startBar,
     int endBar,
     int direction,
     int merges) =>

    array.push(normOpen, o)
    array.push(normHigh, h)
    array.push(normLow, l)
    array.push(normClose, c)

    array.push(normHighBar, hBar)
    array.push(normLowBar, lBar)

    array.push(normStartBar, startBar)
    array.push(normEndBar, endBar)

    array.push(normDirection, direction)
    array.push(normMergeCount, merges)


//=============================================================================
// 09 MAIN NORMALIZATION ENGINE
//=============================================================================

if barstate.isconfirmed

    rawCount += 1

    //-------------------------------------------------------------------------
    // FIRST K
    //-------------------------------------------------------------------------

    if array.size(normHigh) == 0

        addNormalized(
             open,
             high,
             low,
             close,
             bar_index,
             bar_index,
             bar_index,
             bar_index,
             DIR_NONE,
             1)

    //-------------------------------------------------------------------------
    // EXISTING NORMALIZED K
    //-------------------------------------------------------------------------

    else

        int lastIndex = array.size(normHigh) - 1

        float previousOpen =
             array.get(normOpen, lastIndex)

        float previousHigh =
             array.get(normHigh, lastIndex)

        float previousLow =
             array.get(normLow, lastIndex)

        float previousClose =
             array.get(normClose, lastIndex)

        int previousHighBar =
             array.get(normHighBar, lastIndex)

        int previousLowBar =
             array.get(normLowBar, lastIndex)

        int previousStartBar =
             array.get(normStartBar, lastIndex)

        int previousDirection =
             array.get(normDirection, lastIndex)

        int previousMergeCount =
             array.get(normMergeCount, lastIndex)


        //=====================================================================
        // CONTAINMENT TEST
        //=====================================================================

        bool contained =
             isContained(
                  high,
                  low,
                  previousHigh,
                  previousLow)


        //=====================================================================
        // NO CONTAINMENT
        //=====================================================================

        if not contained

            int newDirection =
                 getDirection(
                      high,
                      low,
                      previousHigh,
                      previousLow,
                      previousDirection)

            addNormalized(
                 open,
                 high,
                 low,
                 close,
                 bar_index,
                 bar_index,
                 bar_index,
                 bar_index,
                 newDirection,
                 1)


        //=====================================================================
        // CONTAINMENT
        //=====================================================================

        else

            totalMerges += 1

            int mergeDirection =
                 previousDirection


            //=================================================================
            // ESTABLISH DIRECTION
            //=================================================================

            if mergeDirection == DIR_NONE

                if high > previousHigh and low > previousLow

                    mergeDirection := DIR_UP

                else if high < previousHigh and low < previousLow

                    mergeDirection := DIR_DOWN


            //=================================================================
            // UPWARD MERGE
            //
            // GG:
            //
            // High = higher High
            // Low  = higher Low
            //=================================================================

            if mergeDirection == DIR_UP

                float mergedHigh =
                     math.max(
                          previousHigh,
                          high)

                float mergedLow =
                     math.max(
                          previousLow,
                          low)

                int mergedHighBar =
                     previousHigh >= high ?
                     previousHighBar :
                     bar_index

                int mergedLowBar =
                     previousLow >= low ?
                     previousLowBar :
                     bar_index

                array.set(
                     normHigh,
                     lastIndex,
                     mergedHigh)

                array.set(
                     normLow,
                     lastIndex,
                     mergedLow)

                array.set(
                     normClose,
                     lastIndex,
                     close)

                array.set(
                     normHighBar,
                     lastIndex,
                     mergedHighBar)

                array.set(
                     normLowBar,
                     lastIndex,
                     mergedLowBar)

                array.set(
                     normEndBar,
                     lastIndex,
                     bar_index)

                array.set(
                     normDirection,
                     lastIndex,
                     DIR_UP)

                array.set(
                     normMergeCount,
                     lastIndex,
                     previousMergeCount + 1)


            //=================================================================
            // DOWNWARD MERGE
            //
            // DD:
            //
            // High = lower High
            // Low  = lower Low
            //=================================================================

            else if mergeDirection == DIR_DOWN

                float mergedHigh =
                     math.min(
                          previousHigh,
                          high)

                float mergedLow =
                     math.min(
                          previousLow,
                          low)

                int mergedHighBar =
                     previousHigh <= high ?
                     previousHighBar :
                     bar_index

                int mergedLowBar =
                     previousLow <= low ?
                     previousLowBar :
                     bar_index

                array.set(
                     normHigh,
                     lastIndex,
                     mergedHigh)

                array.set(
                     normLow,
                     lastIndex,
                     mergedLow)

                array.set(
                     normClose,
                     lastIndex,
                     close)

                array.set(
                     normHighBar,
                     lastIndex,
                     mergedHighBar)

                array.set(
                     normLowBar,
                     lastIndex,
                     mergedLowBar)

                array.set(
                     normEndBar,
                     lastIndex,
                     bar_index)

                array.set(
                     normDirection,
                     lastIndex,
                     DIR_DOWN)

                array.set(
                     normMergeCount,
                     lastIndex,
                     previousMergeCount + 1)


            //=================================================================
            // UNKNOWN DIRECTION
            //
            // 不強行判定方向。
            // 保留目前結構範圍。
            //=================================================================

            else

                float mergedHigh =
                     math.max(
                          previousHigh,
                          high)

                float mergedLow =
                     math.min(
                          previousLow,
                          low)

                int mergedHighBar =
                     previousHigh >= high ?
                     previousHighBar :
                     bar_index

                int mergedLowBar =
                     previousLow <= low ?
                     previousLowBar :
                     bar_index

                array.set(
                     normHigh,
                     lastIndex,
                     mergedHigh)

                array.set(
                     normLow,
                     lastIndex,
                     mergedLow)

                array.set(
                     normClose,
                     lastIndex,
                     close)

                array.set(
                     normHighBar,
                     lastIndex,
                     mergedHighBar)

                array.set(
                     normLowBar,
                     lastIndex,
                     mergedLowBar)

                array.set(
                     normEndBar,
                     lastIndex,
                     bar_index)

                array.set(
                     normMergeCount,
                     lastIndex,
                     previousMergeCount + 1)


//=============================================================================
// 10 VISUALIZATION
//=============================================================================

var line highLine = na
var line lowLine = na
var line bodyLine = na


if barstate.islast and showNormalized

    int n = array.size(normHigh)

    if n > 0

        int i = n - 1

        float nOpen =
             array.get(normOpen, i)

        float nHigh =
             array.get(normHigh, i)

        float nLow =
             array.get(normLow, i)

        float nClose =
             array.get(normClose, i)

        int nStart =
             array.get(normStartBar, i)

        int nEnd =
             array.get(normEndBar, i)

        int nDirection =
             array.get(normDirection, i)

        color nColor =
             nDirection == DIR_UP ?
             upColor :
             nDirection == DIR_DOWN ?
             downColor :
             neutralColor


        if not na(highLine)
            line.delete(highLine)

        if not na(lowLine)
            line.delete(lowLine)

        if not na(bodyLine)
            line.delete(bodyLine)


        highLine :=
             line.new(
                  nStart,
                  nHigh,
                  nEnd,
                  nHigh,
                  xloc=xloc.bar_index,
                  color=nColor,
                  width=2)


        lowLine :=
             line.new(
                  nStart,
                  nLow,
                  nEnd,
                  nLow,
                  xloc=xloc.bar_index,
                  color=nColor,
                  width=2)


        bodyLine :=
             line.new(
                  nStart,
                  nOpen,
                  nEnd,
                  nClose,
                  xloc=xloc.bar_index,
                  color=nColor,
                  width=4)


//=============================================================================
// 11 MERGE LABEL
//=============================================================================

if barstate.isconfirmed and showMergeLabel

    int n = array.size(normHigh)

    if n > 0

        int i = n - 1

        int merges =
             array.get(
                  normMergeCount,
                  i)

        if merges > 1

            float labelPrice =
                 array.get(
                      normHigh,
                      i)

            label.new(
                 bar_index,
                 labelPrice,
                 "M" + str.tostring(merges),
                 xloc=xloc.bar_index,
                 style=label.style_label_down,
                 color=color.new(color.blue, 20),
                 textcolor=color.white,
                 size=size.tiny)


//=============================================================================
// 12 SOURCE HIGH / LOW
//=============================================================================

if barstate.isconfirmed and showSourceLabel

    int n = array.size(normHigh)

    if n > 0

        int i = n - 1

        int merges =
             array.get(
                  normMergeCount,
                  i)

        if merges > 1

            int sourceHighBar =
                 array.get(
                      normHighBar,
                      i)

            int sourceLowBar =
                 array.get(
                      normLowBar,
                      i)

            float sourceHigh =
                 array.get(
                      normHigh,
                      i)

            float sourceLow =
                 array.get(
                      normLow,
                      i)


            label.new(
                 sourceHighBar,
                 sourceHigh,
                 "H",
                 xloc=xloc.bar_index,
                 style=label.style_label_down,
                 color=color.new(color.aqua, 20),
                 textcolor=color.white,
                 size=size.tiny)


            label.new(
                 sourceLowBar,
                 sourceLow,
                 "L",
                 xloc=xloc.bar_index,
                 style=label.style_label_up,
                 color=color.new(color.orange, 20),
                 textcolor=color.white,
                 size=size.tiny)


//=============================================================================
// 13 STATUS TABLE
//=============================================================================

var table statusTable =
     table.new(
          position.top_right,
          2,
          7,
          border_width=1)


if barstate.islast

    int n = array.size(normHigh)

    table.cell(
         statusTable,
         0,
         0,
         "TC CHAN")

    table.cell(
         statusTable,
         1,
         0,
         "M1.2")

    table.cell(
         statusTable,
         0,
         1,
         "Raw K")

    table.cell(
         statusTable,
         1,
         1,
         str.tostring(rawCount))

    table.cell(
         statusTable,
         0,
         2,
         "Norm K")

    table.cell(
         statusTable,
         1,
         2,
         str.tostring(n))

    table.cell(
         statusTable,
         0,
         3,
         "Merges")

    table.cell(
         statusTable,
         1,
         3,
         str.tostring(totalMerges))


    if n > 0

        int i = n - 1

        int d =
             array.get(
                  normDirection,
                  i)

        int m =
             array.get(
                  normMergeCount,
                  i)

        string directionText =
             d == DIR_UP ?
             "UP" :
             d == DIR_DOWN ?
             "DOWN" :
             "NONE"


        table.cell(
             statusTable,
             0,
             4,
             "Direction")

        table.cell(
             statusTable,
             1,
             4,
             directionText)


        table.cell(
             statusTable,
             0,
             5,
             "Last Merge")

        table.cell(
             statusTable,
             1,
             5,
             str.tostring(m))


        table.cell(
             statusTable,
             0,
             6,
             "Status")

        table.cell(
             statusTable,
             1,
             6,
             "M1.2 OK")


//=============================================================================
// 14 ALERT
//=============================================================================

bool mergeNow =
     totalMerges > totalMerges[1]

alertcondition(
     mergeNow,
     title="TC Merge",
     message="TC Chan Pro M1.2 Merge")


//=============================================================================
// END
//=============================================================================
