//@version=6
indicator(
     "TC Chan Pro M1 - Fractal + Containment",
     shorttitle = "TC Chan M1",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 100)

//=============================================================================
// TC CHAN PRO
// Milestone : M1
// Module    : Fractal + Containment Core
// Version   : 0.1.0
//
// Design philosophy:
//   1. Practical trading first.
//   2. Chan theory remains the structural core.
//   3. Containment is normalized before fractal detection.
//   4. Core logic does NOT use ta.pivothigh() / ta.pivotlow().
//   5. Confirmed signals are based on closed bars.
//=============================================================================


//=============================================================================
// INPUTS
//=============================================================================

groupGeneral = "01 - General"

showFractals = input.bool(
     true,
     "Show Fractals",
     group = groupGeneral)

showContainment = input.bool(
     true,
     "Show Containment",
     group = groupGeneral)

showDebug = input.bool(
     false,
     "Debug Mode",
     group = groupGeneral)

groupFractal = "02 - Fractal"

fractalMode = input.string(
     "Strict",
     "Fractal Mode",
     options = ["Strict", "Practical"],
     group = groupFractal)

minBarsBetweenFractals = input.int(
     1,
     "Minimum Bars Between Same-Type Fractals",
     minval = 0,
     maxval = 20,
     group = groupFractal)

groupContainment = "03 - Containment"

containmentMode = input.string(
     "Trend Direction",
     "Containment Direction",
     options = ["Trend Direction", "Previous Normalized Bar"],
     group = groupContainment)

groupVisual = "04 - Visual"

topColor = input.color(
     color.red,
     "Top Fractal Color",
     group = groupVisual)

bottomColor = input.color(
     color.lime,
     "Bottom Fractal Color",
     group = groupVisual)

containmentColor = input.color(
     color.orange,
     "Containment Color",
     group = groupVisual)

confirmedColor = input.color(
     color.white,
     "Confirmed Marker Color",
     group = groupVisual)


//=============================================================================
// RAW PRICE DATA
//=============================================================================

rawHigh = high
rawLow = low
rawOpen = open
rawClose = close
rawVolume = volume


//=============================================================================
// CONTAINMENT STATE
//
// normalizedHigh / normalizedLow represent the current normalized structure.
//
// We deliberately keep this engine simple in M1.
// Later M2 will replace this with a full normalized-bar array engine.
//=============================================================================

var float normHigh = na
var float normLow = na
var float normOpen = na
var float normClose = na
var int normBarIndex = na
var int normDirection = 0
var bool normIsContainment = false


//=============================================================================
// DIRECTION DETECTION
//
//  1 = bullish structural direction
// -1 = bearish structural direction
//  0 = undefined
//=============================================================================

previousHigh = nz(normHigh[1], high[1])
previousLow = nz(normLow[1], low[1])

bullExpansion =
     high > previousHigh and
     low > previousLow

bearExpansion =
     high < previousHigh and
     low < previousLow

if bullExpansion
    normDirection := 1
else if bearExpansion
    normDirection := -1


//=============================================================================
// INITIALIZE NORMALIZED BAR
//=============================================================================

if barstate.isfirst
    normHigh := high
    normLow := low
    normOpen := open
    normClose := close
    normBarIndex := bar_index
    normIsContainment := false


//=============================================================================
// CONTAINMENT DETECTION
//
// A contains B:
//
// A.high >= B.high AND A.low <= B.low
//
// B contains A:
//
// B.high >= A.high AND B.low <= A.low
//=============================================================================

containsPrevious =
     high >= previousHigh and
     low <= previousLow

previousContainsCurrent =
     previousHigh >= high and
     previousLow <= low

hasContainment =
     containsPrevious or
     previousContainsCurrent


//=============================================================================
// NORMALIZATION
//
// Practical rule:
//
// Bullish direction:
//     keep the higher high and higher low.
//
// Bearish direction:
//     keep the lower high and lower low.
//
// Undefined direction:
//     use the previous normalized structure.
//
// This is the engineering interpretation used by TC Chan Pro.
//=============================================================================

if barstate.isconfirmed

    if hasContainment

        normIsContainment := true

        if containmentMode == "Trend Direction"

            if normDirection >= 0

                normHigh := math.max(previousHigh, high)
                normLow := math.max(previousLow, low)

            else

                normHigh := math.min(previousHigh, high)
                normLow := math.min(previousLow, low)

        else

            if high >= previousHigh
                normHigh := high
            else
                normHigh := previousHigh

            if low <= previousLow
                normLow := low
            else
                normLow := previousLow

        normOpen := open
        normClose := close
        normBarIndex := bar_index

    else

        normIsContainment := false

        normHigh := high
        normLow := low
        normOpen := open
        normClose := close
        normBarIndex := bar_index


//=============================================================================
// FRACTAL ENGINE
//
// IMPORTANT:
//
// We do NOT use ta.pivothigh() / ta.pivotlow().
//
// A fractal is confirmed only after the right-side bar closes.
//
// Candidate structure:
//
//       H
//      / \
//     L   L
//
// Strict:
//     center high > both neighboring highs
//
// Practical:
//     equal highs/lows are allowed with a directional tie-break.
//=============================================================================

enoughBars = bar_index >= 2

//----------------------------------------------------------------------------
// Raw three-bar structure
//----------------------------------------------------------------------------

rawTop =
     enoughBars and
     high[1] > high[2] and
     high[1] > high

rawBottom =
     enoughBars and
     low[1] < low[2] and
     low[1] < low


//----------------------------------------------------------------------------
// Practical equality handling
//----------------------------------------------------------------------------

practicalTop =
     enoughBars and
     high[1] >= high[2] and
     high[1] >= high and
     (high[1] > high[2] or high[1] > high)

practicalBottom =
     enoughBars and
     low[1] <= low[2] and
     low[1] <= low and
     (low[1] < low[2] or low[1] < low)


//----------------------------------------------------------------------------
// Select mode
//----------------------------------------------------------------------------

candidateTop =
     fractalMode == "Strict"
     ? rawTop
     : practicalTop

candidateBottom =
     fractalMode == "Strict"
     ? rawBottom
     : practicalBottom


//=============================================================================
// FRACTAL CONFIRMATION
//=============================================================================

confirmedTop =
     barstate.isconfirmed and
     candidateTop

confirmedBottom =
     barstate.isconfirmed and
     candidateBottom


//=============================================================================
// FRACTAL MEMORY
//=============================================================================

var int lastTopBar = na
var int lastBottomBar = na

var float lastTopPrice = na
var float lastBottomPrice = na

var int topCount = 0
var int bottomCount = 0


//=============================================================================
// MINIMUM DISTANCE FILTER
//=============================================================================

topDistanceOK =
     na(lastTopBar) or
     (bar_index - 1 - lastTopBar >= minBarsBetweenFractals)

bottomDistanceOK =
     na(lastBottomBar) or
     (bar_index - 1 - lastBottomBar >= minBarsBetweenFractals)

validTop =
     confirmedTop and
     topDistanceOK

validBottom =
     confirmedBottom and
     bottomDistanceOK


//=============================================================================
// STORE FRACTALS
//=============================================================================

if validTop

    lastTopBar := bar_index - 1
    lastTopPrice := high[1]
    topCount += 1

if validBottom

    lastBottomBar := bar_index - 1
    lastBottomPrice := low[1]
    bottomCount += 1


//=============================================================================
// FRACTAL PLOTS
//
// Offset -1 because the fractal center is the previous bar.
//=============================================================================

plotshape(
     showFractals and validTop,
     title = "TC Top Fractal",
     style = shape.triangledown,
     location = location.abovebar,
     color = topColor,
     size = size.tiny,
     offset = -1)

plotshape(
     showFractals and validBottom,
     title = "TC Bottom Fractal",
     style = shape.triangleup,
     location = location.belowbar,
     color = bottomColor,
     size = size.tiny,
     offset = -1)


//=============================================================================
// CONTAINMENT VISUALIZATION
//=============================================================================

plotshape(
     showContainment and hasContainment and barstate.isconfirmed,
     title = "Containment",
     style = shape.circle,
     location = location.abovebar,
     color = containmentColor,
     size = size.tiny)


//=============================================================================
// FRACTAL ALERT CONDITIONS
//=============================================================================

alertcondition(
     validTop,
     title = "TC Chan Top Fractal",
     message = "TC Chan Pro: Confirmed Top Fractal")

alertcondition(
     validBottom,
     title = "TC Chan Bottom Fractal",
     message = "TC Chan Pro: Confirmed Bottom Fractal")


//=============================================================================
// DEBUG TABLE
//=============================================================================

var table debugTable = table.new(
     position.top_right,
     2,
     10,
     border_width = 1)

if barstate.islast and showDebug

    table.cell(
         debugTable,
         0,
         0,
         "TC CHAN M1",
         text_color = color.white)

    table.cell(
         debugTable,
         1,
         0,
         "DEBUG",
         text_color = color.yellow)

    table.cell(
         debugTable,
         0,
         1,
         "Top Count")

    table.cell(
         debugTable,
         1,
         1,
         str.tostring(topCount))

    table.cell(
         debugTable,
         0,
         2,
         "Bottom Count")

    table.cell(
         debugTable,
         1,
         2,
         str.tostring(bottomCount))

    table.cell(
         debugTable,
         0,
         3,
         "Last Top")

    table.cell(
         debugTable,
         1,
         3,
         str.tostring(lastTopPrice))

    table.cell(
         debugTable,
         0,
         4,
         "Last Bottom")

    table.cell(
         debugTable,
         1,
         4,
         str.tostring(lastBottomPrice))

    table.cell(
         debugTable,
         0,
         5,
         "Containment")

    table.cell(
         debugTable,
         1,
         5,
         hasContainment ? "YES" : "NO")

    table.cell(
         debugTable,
         0,
         6,
         "Direction")

    table.cell(
         debugTable,
         1,
         6,
         normDirection == 1 ? "BULL" :
         normDirection == -1 ? "BEAR" :
         "UNDEFINED")

    table.cell(
         debugTable,
         0,
         7,
         "Norm High")

    table.cell(
         debugTable,
         1,
         7,
         str.tostring(normHigh))

    table.cell(
         debugTable,
         0,
         8,
         "Norm Low")

    table.cell(
         debugTable,
         1,
         8,
         str.tostring(normLow))

    table.cell(
         debugTable,
         0,
         9,
         "Version")

    table.cell(
         debugTable,
         1,
         9,
         "M1 0.1.0")


//=============================================================================
// END
//=============================================================================
